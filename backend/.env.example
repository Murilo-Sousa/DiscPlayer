# Copie este arquivo para `.env` (na pasta backend/) e ajuste os valores.
# O arquivo `.env` real está no .gitignore: nunca o envie ao GitHub.

# ---- IGDB (obrigatório para o catálogo de jogos) --------------------------------
# O IGDB é o banco de jogos da Twitch. Para usá-lo, crie um aplicativo (grátis) em https://dev.twitch.tv/console
# (a conta da Twitch precisa de verificação em duas etapas): em "Registrar seu aplicativo", use
#   URL de redirecionamento OAuth: http://localhost      Categoria: Website Integration
#   Tipo de cliente: Confidential
# Depois copie o "ID de cliente" e clique em "Novo segredo". Os dois ficam só no servidor: o navegador nunca os
# recebe, e o segredo NUNCA deve ser enviado ao GitHub nem colado em conversas.
# Para conferir se deu certo:  python -m app.igdb_check
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Conteúdo adulto. O IGDB também lista jogos 18+; o DiscPlayer os esconde da busca, do catálogo, da página inicial
# e da página do jogo. Escolha o nível:
#   explicit  esconde o que é classificado como "Adults Only" (ESRB) ou tem o tema "Erotic" (padrão)
#   mature    também esconde o que alguma classificação põe em 17+/18+ (ESRB Mature, PEGI 18, USK 18, ClassInd 18...),
#             o que pega jogos comuns de violência (The Witcher, Red Dead Redemption...)
#   off       não esconde nada
# Qualquer outro valor vale como "explicit". Reinicie o servidor depois de mudar.
ADULT_CONTENT_FILTER=explicit

# ---- Ambiente -------------------------------------------------------------------
# development (padrão) ou production.
# Em production, SECRET_KEY é obrigatória e o cookie de sessão exige HTTPS.
APP_ENV=development

# Chave que assina o cookie de sessão. Em desenvolvimento pode ficar vazia: o app
# gera uma e guarda em backend/instance/secret_key. Em produção, gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- Banco de dados -------------------------------------------------------------
# Padrão: backend/instance/discplayer.db (criado na primeira execução).
# DATABASE_PATH=/caminho/absoluto/para/discplayer.db

# Aplica as migrações SQL pendentes ao iniciar (true/false).
AUTO_MIGRATE=true

# ---- Rede e cookies (opcional) --------------------------------------------------
# Origens extras autorizadas a chamar a API, separadas por vírgula.
# Não é necessário no desenvolvimento normal: o Vite faz proxy de /api.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Em produção o cookie só trafega por HTTPS. Para testar o build de produção em
# http://localhost, defina COOKIE_SECURE=false.
# COOKIE_SECURE=false

# Quantos proxies reversos (nginx, Caddy...) ficam na frente do app. Necessário
# para o limite de tentativas enxergar o IP real do visitante.
TRUSTED_PROXY_COUNT=0

# Endereço público do site, usado nas prévias de links (WhatsApp, Discord, LinkedIn).
# Opcional: vazio usa o endereço da própria requisição. Ao publicar, defina, por exemplo:
# PUBLIC_URL=https://discplayer.pythonanywhere.com

# Limite de requisições por minuto (login, cadastro, busca, catálogo, escritas). true/false.
RATELIMIT_ENABLED=true

# ---- Só para desenvolvimento sem credenciais do IGDB -----------------------------
# Aponta para o servidor de dados FICTÍCIOS do projeto, que imita também o login da Twitch (veja
# docs/desenvolvimento.md). IGDB_CLIENT_ID e IGDB_CLIENT_SECRET podem ter qualquer valor.
# IGDB_BASE_URL=http://127.0.0.1:8765/v4
# IGDB_TOKEN_URL=http://127.0.0.1:8765/oauth2/token
